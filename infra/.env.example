# Environment & Server
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
PUBLIC_BASE_URL=http://localhost

# MongoDB Replica Set Connection
MONGO_URI=mongodb://localhost:27017/eduassess?replicaSet=rs0
MONGO_DB=eduassess

# Redis (Queue, Cache, SSE PubSub, Rate Limits)
REDIS_URL=redis://localhost:6379

# Object Storage S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=eduassess-storage
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_USE_SSL=false

# JWT Authentication
JWT_ACCESS_SECRET=your_jwt_access_ed25519_or_hmac_secret_must_be_long_and_random
JWT_ACCESS_TTL_S=900
REFRESH_TTL_STUDENT_S=43200
EXAM_TOKEN_HMAC_KEY=exam_hmac_secret_key_random_value

# Password Hashing (Argon2id OWASP minimum initial settings)
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Rate Limiting & Sweeper
LOGIN_MAX_FAILS=5
LOGIN_WINDOW_S=900
GRACE_SECONDS_DEFAULT=120
SWEEPER_INTERVAL_S=30

# Antivirus
CLAMAV_HOST=localhost:3310

# LLM Essay Grading
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=60000
LLM_CONCURRENCY=10
LLM_API_KEY=mock-key
AI_BUDGET_TOKENS_DEFAULT=200000

# Feature Flags
FEATURE_AI_GRADING=false
FEATURE_AI_SHADOW=true
FEATURE_EXAM_MODE_B=false
FEATURE_INGESTION_PDF=false

# Retention (Days)
RETENTION_INTEGRITY_LOGS_DAYS=180
RETENTION_STAGING_DAYS=30
RETENTION_NOTIFICATIONS_DAYS=90

